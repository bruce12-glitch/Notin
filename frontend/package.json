{
  "name": "notin-landing",
  "version": "1.0.0",
  "main": "script.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "node --check script.js && node --check dev-server.mjs",
    "build": "npx @tailwindcss/cli -i ./input.css -o ./styles.css --minify && npx @tailwindcss/cli -i ./input-neon.css -o ./styles-neon.css --minify",
    "build:green": "npx @tailwindcss/cli -i ./input.css -o ./styles.css --minify",
    "build:neon": "npx @tailwindcss/cli -i ./input-neon.css -o ./styles-neon.css --minify",
    "test": "npm run check"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Notin marketing site (Green/Neon editions), served by the unified backend at /site/",
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "tailwindcss": "4.3.0"
  }
}
