{
  "name": "notin-authentication",
  "version": "1.1.0",
  "description": "Hardened JWT authentication, email OTP verification, and user-scoped notes API for Notin.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "prestart": "node scripts/preflight.js",
    "start": "node server.js",
    "db:check": "node scripts/preflight.js",
    "test": "node test-auth.js",
    "check": "node --check server.js && node --check public/app.js && npm test",
    "security:audit": "npm audit --omit=dev"
  },
  "keywords": [
    "authentication",
    "jwt",
    "sqlite",
    "otp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.4",
    "zod": "^4.4.3"
  }
}
