# Runtime
NODE_ENV=development
PORT=4000
TRUST_PROXY=1
DB_PATH=./auth.db
APP_URL=http://localhost:4000

# Generate four independent values with `npm run setup`.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
CSRF_SECRET=
OTP_PEPPER=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
JWT_ISSUER=notin-auth
JWT_AUDIENCE=notin-web

# Password and abuse controls
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30

# Cookie / browser policy
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:8000,http://127.0.0.1:5500

# Email — leaving SMTP blank enables explicit development-only OTP/reset output.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Notin <no-reply@notin.app>
