// Documentation mirror of the live schema.
// SQL is applied by `npm run db:migrate` (src/db/migrate.js) on both Postgres
// and the SQLite dev fallback. This file documents that schema; the repo does
// not run `prisma generate` and does not depend on @prisma/client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?
  password  String?
  googleSub String?  @unique @map("google_sub")
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  notes               Note[]
  notebooks           Notebook[]
  tags                Tag[]
  attachments         Attachment[]
  noteShares          NoteShare[]
  otpChallenges       OtpChallenge[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

// WP-HARDEN-001 — PostgreSQL additionally creates three GIN *expression*
// indexes (applied by src/db/migrate.js; not expressible in Prisma's schema
// syntax, so they are documented here instead):
//   Note_title_fts_idx       GIN (to_tsvector('simple', title))
//   Note_content_fts_idx     GIN (to_tsvector('simple', COALESCE("contentText", '')))
//   Note_description_fts_idx GIN (to_tsvector('simple', COALESCE(description, '')))
// They back GET /api/notes?q= full-text search (websearch_to_tsquery +
// ts_rank_cd). The SQLite dev fallback uses the same query shape via
// escaped-LIKE and intentionally has no FTS tables.
model Note {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  contentJson String?   @db.Text @map("contentJson")
  contentText String?   @db.Text @map("contentText")
  summary     String?   @db.Text
  isTrashed   Boolean   @default(false) @map("isTrashed")
  isPinned    Boolean   @default(false) @map("isPinned")
  trashedAt   DateTime? @map("trashedAt")
  userId      String    @map("userId")
  notebookId  String?   @map("notebookId")
  createdAt   DateTime  @default(now()) @map("createdAt")
  updatedAt   DateTime  @updatedAt @map("updatedAt")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook    Notebook?    @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  noteTags    NoteTag[]
  share       NoteShare?

  @@index([userId])
  @@index([isTrashed])
  @@index([isPinned])
  @@index([notebookId])
  @@map("Note")
}

model Notebook {
  id        String   @id @default(cuid())
  userId    String   @map("userId")
  name      String
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]

  @@index([userId])
  @@map("Notebook")
}

model Tag {
  id        String   @id @default(cuid())
  userId    String   @map("userId")
  name      String
  createdAt DateTime @default(now()) @map("createdAt")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteTags NoteTag[]

  @@index([userId])
  @@map("Tag")
}

model NoteTag {
  noteId    String   @map("noteId")
  tagId     String   @map("tagId")
  createdAt DateTime @default(now()) @map("createdAt")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([noteId])
  @@index([tagId])
  @@map("NoteTag")
}

model Attachment {
  id        String   @id
  noteId    String   @map("noteId")
  userId    String   @map("userId")
  filename  String
  mime      String
  size      Int
  path      String
  createdAt DateTime @default(now()) @map("createdAt")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([userId])
  @@map("Attachment")
}

model NoteShare {
  id           String    @id
  noteId       String    @unique @map("noteId")
  userId       String    @map("userId")
  tokenHash    String    @unique @map("tokenHash")
  shareEnabled Boolean   @default(true) @map("shareEnabled")
  createdAt    DateTime  @default(now()) @map("createdAt")
  expiresAt    DateTime? @map("expiresAt")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("NoteShare")
}

model OtpChallenge {
  id        String    @id
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model RefreshToken {
  hash      String    @id
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  // WP-SEC-001 — rotation family + replay-detection reason (docs-only mirror of migrate.js)
  familyId     String?  @map("family_id")
  revokeReason String?  @map("revoke_reason")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// WP-SEC-003 mirror — migrate.js is authoritative
model AuthThrottle {
  email       String
  scope       String
  count       Int       @default(0)
  windowStart DateTime? @map("window_start")
  lockLevel   Int       @default(0) @map("lock_level")
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  @@id([email, scope])
  @@map("auth_throttle")
}
