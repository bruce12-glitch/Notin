# ── Notin Unified API — single Postgres for users + auth + notes ──
# Copy to .env and fill every value before running

# Database — PostgreSQL (required for production)
# Example: postgresql://user:password@localhost:5432/notin?schema=public
# For local sandbox without Postgres, the API falls back to SQLite at prisma/notin.sqlite
DATABASE_URL="postgresql://username:password@localhost:5432/notin?schema=public"
# Optional SQLite fallback path when DATABASE_URL is not postgres
SQLITE_PATH="./prisma/notin.sqlite"
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=12000

# JWT — ONE issuer for auth + notes (must match across services)
# PRODUCTION: the three change-me values below MUST be replaced — boot refuses them
JWT_ACCESS_SECRET="change-me-access-32chars-minimum-replace-in-prod"
JWT_REFRESH_SECRET="change-me-refresh-32chars-minimum-replace-in-prod"
JWT_ISSUER="notin-auth"
# Legacy fallback (still read if old JWT_SECRET is set)
JWT_SECRET="fallback-legacy-secret-compat"

# OTP
OTP_PEPPER="change-me-pepper-32chars-minimum-replace"
# Optional — falls back to OTP_PEPPER
RESET_PEPPER=

# App
# Comma-separated browser origins allowed by CORS. The first is canonical unless
# PUBLIC_APP_URL is set explicitly.
APP_ORIGIN="http://localhost:4173"
PUBLIC_APP_URL="http://localhost:5000"
# Must match the exact reverse-proxy topology (hop count, IP/CIDR, or Express value).
TRUST_PROXY=1
PORT=5000
NODE_ENV="development"
# Image attachments (PNG/JPEG/WebP/GIF only); defaults to backend/uploads
UPLOAD_DIR="./uploads"
# Abuse/cost ceilings (server defaults shown)
MAX_NOTES_PER_USER=5000
MAX_ATTACHMENT_STORAGE_BYTES=262144000
# Public share links expire after this many days; 0 disables expiry.
SHARE_TTL_DAYS=30

# Optional error monitoring — leave empty to disable/no-op
SENTRY_DSN=
# Optional label sent with errors (defaults to NODE_ENV)
SENTRY_ENVIRONMENT=

# Google OAuth (optional — leave blank to stub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Unified API callback only; do not run the legacy :8787 auth server
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"

# Email auth. Production boot requires complete SMTP settings unless this is
# explicitly false. Demo OTP 123456 remains development-only.
AUTH_EMAIL_ENABLED=true
# Direct password signup bypasses email verification; keep false in production.
ALLOW_PASSWORD_SIGNUP=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Notin <noreply@notin.app>"

# ── AI (Phase 2) ──
# Groq API key (https://console.groq.com). Leave blank to run AI features in
# deterministic mock mode (no network calls) — used by E2E and local dev.
GROQ_API_KEY=
