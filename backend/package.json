{
  "name": "notin-backend",
  "version": "1.0.0",
  "description": "Notin Backend - Clean PostgreSQL API (Prisma schema + pg driver)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:generate": "echo 'Schema is applied via npm run db:migrate (pg driver). prisma/schema.prisma is the source of truth for the data model.'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
