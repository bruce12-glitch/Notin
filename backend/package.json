{
  "name": "notin-backend",
  "version": "1.0.0",
  "description": "Notin Backend - Clean PostgreSQL API (Prisma schema + pg driver)",
  "main": "src/server.js",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:generate": "echo 'SQL is applied by npm run db:migrate (migrate.js). prisma/schema.prisma documents that schema; this repo does not run prisma generate.'",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.js",
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "lint": "eslint src tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@sentry/node": "^10.69.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.1"
  }
}
